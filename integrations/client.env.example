# Copy this file to .env on each client machine and fill in the server token.
LITTLE_OFFICE_URL=https://office.nekoding.xyz
LITTLE_OFFICE_API_TOKEN=replace-with-the-server-token
# Public-safe default: stable alias such as Moss-42; never sends the raw folder name.
LITTLE_OFFICE_NAME_MODE=alias
# Options: project (private server), alias (recommended), random, hidden.
# Optional: set a shared private value if Hermes and Codex on one device need the same aliases.
# LITTLE_OFFICE_NAME_SALT=keep-this-local
# Hide the machine label from the public connections panel by default.
LITTLE_OFFICE_MACHINE_LABEL_MODE=hidden
# Only use show on a private server or LAN.
# LITTLE_OFFICE_MACHINE_LABEL=Mac kerja
