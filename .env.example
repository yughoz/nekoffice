# Central server settings. Generate a secret: python3 -c "import secrets; print(secrets.token_hex(32))"
OFFICE_API_TOKEN=replace-with-a-random-secret-at-least-32-characters
HOST=0.0.0.0
PORT=3000
# Maximum simultaneous browser viewers. Increase only when the server can handle more live avatars.
OFFICE_MAX_VIEWERS=3
# Optional: mirror accepted API writes to a second NekOffice server.
# Use the target origin, for example https://holding.neko.my.id.
# OFFICE_MIRROR_URL=https://holding.neko.my.id
# OFFICE_MIRROR_TOKEN=target-server-token-at-least-32-characters
